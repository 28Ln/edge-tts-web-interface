# Edge TTS Web Interface 配置文件
# 复制此文件为 .env 并填写实际值

# ==================== 环境配置 ====================
# 可选值: development, testing, production
APP_ENV=development
FLASK_DEBUG=0

# ==================== 服务器配置 ====================
PORT=3003
LOG_LEVEL=INFO
# 日志格式: text 或 json (生产环境建议 json)
LOG_FORMAT=text

# ==================== 安全配置 (生产环境必须修改!) ====================
# Session 密钥 - 生产环境必须设置为至少 32 字符的随机字符串
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# 管理员密码 - 生产环境必须修改!
ADMIN_PASSWORD=admin123

# ==================== 限流配置 ====================
# 每分钟每 IP 最大请求数
RATE_LIMIT_PER_MINUTE=100

# ==================== AI 配置 ====================
# 支持 OpenAI 兼容接口 (DeepSeek, Gemini, OpenAI 等)
# 推荐使用新变量名 (AI_*)，旧变量名 (GEMINI_*) 仍然兼容
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=your_api_key_here
# 可选模型: gpt-4, gpt-3.5-turbo, deepseek-r1-search, deepseek-v3
AI_MODEL=gpt-3.5-turbo

# 旧变量名 (兼容)
# GEMINI_API_BASE=https://api.openai.com/v1
# GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gpt-3.5-turbo

# ==================== 腾讯云 ASR 配置 ====================
# 获取地址: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_APPID=your_appid

# ==================== 数据库连接池配置 ====================
# 数据库路径
DATABASE_PATH=data/auth.db
# 最小连接数
DB_POOL_MIN_CONNECTIONS=2
# 最大连接数
DB_POOL_MAX_CONNECTIONS=10
# 连接超时（秒）
DB_POOL_CONNECTION_TIMEOUT=30
# 空闲连接超时（秒）
DB_POOL_IDLE_TIMEOUT=300

# ==================== Gunicorn 配置 (生产环境) ====================
# 绑定地址
GUNICORN_BIND=0.0.0.0:5000
# Worker 数量 (默认: CPU核心数 * 2 + 1)
# GUNICORN_WORKERS=5
# Worker 类型: sync, gevent, eventlet
GUNICORN_WORKER_CLASS=sync
# 每个 Worker 的线程数
GUNICORN_THREADS=2
# 请求超时（秒）
GUNICORN_TIMEOUT=120
# Worker 最大请求数后重启（防止内存泄漏）
GUNICORN_MAX_REQUESTS=1000
# 日志级别
GUNICORN_LOG_LEVEL=info

# ==================== 可选配置 ====================
# Vosk 模型路径 (本地离线识别)
# VOSK_MODEL_PATH=vosk-model-small-cn-0.22

# 日志文件路径 (不设置则只输出到控制台)
# LOG_FILE=logs/app.log

# Redis URL (用于分布式部署)
# REDIS_URL=redis://localhost:6379/0
