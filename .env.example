# Edge TTS Web Interface 配置文件
# 复制此文件为 .env 并填写实际值

# ==================== 服务器配置 ====================
PORT=3003
DEBUG=false
LOG_LEVEL=INFO

# ==================== AI 配置 ====================
# 支持 OpenAI 兼容接口 (DeepSeek, Gemini, OpenAI 等)
GEMINI_API_BASE=https://api.openai.com/v1
GEMINI_API_KEY=your_api_key_here
# 可选模型: gpt-4, gpt-3.5-turbo, deepseek-r1-search, deepseek-v3
GEMINI_MODEL=gpt-3.5-turbo

# ==================== 腾讯云 ASR 配置 ====================
# 获取地址: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your_secret_id
TENCENT_SECRET_KEY=your_secret_key
TENCENT_APPID=your_appid

# ==================== 可选配置 ====================
# Vosk 模型路径 (本地离线识别)
# VOSK_MODEL_PATH=vosk-model-small-cn-0.22

# 日志文件路径 (不设置则只输出到控制台)
# LOG_FILE=logs/app.log
