menu "EdgeTTS Client Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "your_wifi_ssid"
        help
            SSID (network name) to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "your_wifi_password"
        help
            WiFi password (WPA or WPA2).

    config EDGETTS_SERVER_HOST
        string "EdgeTTS Server Host"
        default "192.168.1.100"
        help
            EdgeTTS server IP address or hostname.

    config EDGETTS_SERVER_PORT
        int "EdgeTTS Server Port"
        default 3003
        help
            EdgeTTS server port number.

endmenu
